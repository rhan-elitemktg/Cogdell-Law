---
// Episode page at /podcast/[slug]: a date line, then the artwork — which carries
// the episode's <h1> and a play button, and becomes the YouTube player when
// clicked — then the show-notes body and a related-episodes grid.
//
// There is no separate title heading above the artwork any more, and no audio
// player below it: the video IS the episode, so it sits where the artwork was.
import Layout from "../../layouts/Layout.astro";
import { PortableText } from "astro-portabletext";
import { proseBodyComponents } from "../../components/prose/bodyComponents";
import YouTubeArtwork from "../../components/podcast/YouTubeArtwork.astro";
import RelatedPodcasts from "../../components/podcast/RelatedPodcasts.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import CtaBar from "../../components/CtaBar.astro";
import Consult from "../../components/Consult.astro";
import { getPodcast, getPodcastSlugs } from "../../sanity/lib/podcast";
import { videoObjectSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const slugs = await getPodcastSlugs();
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const episode = await getPodcast(slug!);

if (!episode) {
  throw new Error(`No podcast episode found in Sanity for slug "${slug}".`);
}

const title = episode.title ?? "";
const dateLabel = episode.date
  ? new Date(episode.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : "";
const hasBody = Array.isArray(episode.body) && episode.body.length > 0;
const description = episode.summary ?? `${title} — the Cogdell Law Uncensored podcast.`;

// Most episodes carry little or no body copy, so the structured data is doing
// real work here: it's what makes these pages legible to search as video rather
// than as thin text pages.
const videoSchema = videoObjectSchema({
  name: title,
  description,
  youtubeId: episode.youtubeId,
  uploadDate: episode.date,
  pageUrl: Astro.url,
});
---

<Layout title={title} description={description} seo={episode.seo} youtubeEmbed>
  {videoSchema && <JsonLd data={videoSchema} />}
  <article class="episode">
    <div class="container">
      <div class="episode__col">
        <p class="episode__meta">
          {dateLabel && <span class="episode__date">{dateLabel}</span>}
        </p>

        {/* Carries the page's one <h1>. */}
        <div class="episode__art">
          <YouTubeArtwork title={title} youtubeId={episode.youtubeId} image={episode.coverImage} />
        </div>

        {
          hasBody && (
            <div class="episode__prose">
              <PortableText value={episode.body} components={proseBodyComponents} />
            </div>
          )
        }
      </div>
    </div>
  </article>

  <RelatedPodcasts items={episode.related ?? []} />

  <CtaBar />
  <Consult />
</Layout>

<style>
  .episode {
    background-color: var(--cog-white);
  }
  .episode__col {
    max-width: 820px;
    margin-inline: auto;
    padding-block: var(--space-section);
  }

  .episode__meta {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .episode__date {
    color: var(--cog-ink-muted);
  }

  /* The artwork now carries the page's <h1>, so it sits tighter to the date line
     than it did when a separate heading came between them. */
  .episode__art {
    margin: var(--space-4) 0 var(--space-12);
  }

  /* ---- Body copy ---- */
  .episode__prose :global(.prose__h2) {
    margin: var(--space-12) 0 var(--space-4);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    color: var(--cog-ink);
  }
  .episode__prose :global(.prose__h3) {
    margin: var(--space-8) 0 var(--space-3);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.25;
    color: var(--cog-ink);
  }
  .episode__prose :global(.prose__p:first-child) {
    /* An italic lead line often opens the notes; keep it snug to the artwork. */
    margin-top: 0;
  }
</style>
