---
// "Areas We Serve" location pages at /{city}/{slug}. Same layout as a single
// practice area — widened hero, breadcrumb above the body, two-column body with
// a sticky rail — but the rail's tree is Areas We Serve rather than Practice
// Areas. Location pages have no child-topic grid, so the page ends at the CTA.
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/practice/Breadcrumb.astro";
import PageHero from "../../components/PageHero.astro";
import ProseBody from "../../components/prose/ProseBody.astro";
import PracticeFaqs from "../../components/practice/PracticeFaqs.astro";
import Rail from "../../components/rail/Rail.astro";
import CtaBar from "../../components/CtaBar.astro";
import Consult from "../../components/Consult.astro";
import { getAreaPaths, getLocationPage } from "../../sanity/lib/areasWeServe";
import { getAreasWeServeNav } from "../../data/navigation";
import defaultHeroImage from "../../assets/firm-steps.jpg";

export async function getStaticPaths() {
  return getAreaPaths();
}

// Looked up from `params`, NOT taken from getStaticPaths props: Astro caches
// those per route module for the dev server's whole lifetime, so props go stale
// the moment anyone edits content in the Studio and only a restart clears it.
// In a production build this costs nothing — it reads the same cached list
// getStaticPaths already built.
const { city, slug } = Astro.params;
const entry = await getLocationPage(city ?? "", slug ?? "");
if (!entry) {
  throw new Error(
    `No location page at "/${city}/${slug}".\n` +
      "In dev this usually means a slug or city changed in the Studio: Astro is " +
      "still serving the route list it cached at startup. Restart the dev server.",
  );
}
const { page, cityName, trail } = entry;

const description = page.lede ?? `${page.title} — Cogdell Law Firm.`;

// The lede is its own field (meta description + card summary) and also opens the
// body, exactly as before the intro/sections merge.
const ledeBlock = page.lede
  ? [{ _type: "block", _key: "lede", style: "normal", markDefs: [], children: [{ _type: "span", _key: "ledes", text: page.lede, marks: [] }] }]
  : [];
const bodyValue = [...ledeBlock, ...(page.body ?? [])];

// The rail's tree is the same branch the header menu renders.
const areasNav = await getAreasWeServeNav();

// Every location shares one firm photo unless an editor uploads its own. A
// custom upload gets an empty alt: it's a backdrop behind the H1 and we have no
// idea what it depicts, so announcing it would be noise.
const hasCustomHero = Boolean(page.heroImage);
const heroImageAlt = hasCustomHero
  ? ""
  : "The attorneys of Cogdell Law Firm ascending the courthouse steps";
---

<Layout title={page.title} description={description} seo={page.seo}>
  <PageHero
    eyebrow={`Serving ${cityName}`}
    titleStrong={page.heroTitle}
    align="center"
    contentMaxWidth="none"
    image={hasCustomHero ? undefined : defaultHeroImage}
    sanityImage={page.heroImage}
    imageAlt={heroImageAlt}
    imagePosition="center 35%"
  >
    <a href="#case-evaluation" class="btn btn--primary">
      Schedule a Consultation
      <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
    <a href="tel:7134262244" class="btn btn--outline">
      Call Us Today
      <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </PageHero>

  <section class="loc-body">
    <div class="container loc-body__inner">
      <Breadcrumb trail={trail} bare />

      <div class="loc-body__grid">
        {/* A plain div, not <main>: the layout has no main landmark today, and
            adding one here would claim only the body column — sending "skip to
            main content" past the hero. The <aside> rail is still a
            complementary landmark, which is what a sidebar should be. */}
        <div class="loc-body__main">
          <ProseBody body={bodyValue} bare />
          {page.faqs && page.faqs.length > 0 && (
            <PracticeFaqs faqs={page.faqs} variant="card" />
          )}
        </div>

        <Rail
          pathname={Astro.url.pathname}
          navHeading="Areas We Serve"
          navItems={areasNav.children ?? []}
        />
      </div>
    </div>
  </section>

  <CtaBar />
  <Consult />
</Layout>

<style>
  .loc-body {
    background-color: var(--cog-paper);
  }
  /* No width cap of its own — this page runs at the one global `.container`
     width, same as every other section on the site. The hero matches by taking
     `contentMaxWidth="none"`, so hero, breadcrumb, body and rail all share the
     container's edges. */
  .loc-body__inner {
    padding-block: var(--space-section);
  }

  .loc-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 414px;
    gap: var(--space-16);
    /* Required for the rail's `position: sticky` — the default `stretch` would
       make the column full-height and sticky would never engage. */
    align-items: start;
  }

  @media (max-width: 1024px) {
    .loc-body__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
</style>
