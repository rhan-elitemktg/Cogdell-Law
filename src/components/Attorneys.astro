---
// Homepage "The Firm" attorneys section — header + four attorney cards.
// Desktop: 4-up grid. Tablet/mobile: horizontal peek carousel (no scrollbar).
import Eyebrow from "./Eyebrow.astro";
import { PortableText } from "astro-portabletext";
import { proseComponents } from "./prose/components";
import AttorneysLede from "./attorneys/AttorneysLede.astro";
import { getAttorneyCards } from "../sanity/lib/attorneys";
import { urlFor } from "../sanity/lib/image";

// Photos live in Sanity (D6: a new hire shouldn't need a developer), so they're
// served from Sanity's CDN via urlFor rather than the astro:assets pipeline.
// These widths and `sizes` match what <Image> emitted before the move.
const PHOTO_WIDTHS = [300, 460, 600, 790];
const PHOTO_SIZES = "(max-width: 650px) 80vw, (max-width: 900px) 44vw, 22vw";

const attorneys = await getAttorneyCards();

if (!attorneys.length) {
  throw new Error(
    "No Attorneys found in Sanity.\n" +
      "Add them in the Studio at /admin → Attorney, or seed them with:\n" +
      "  npx sanity exec scripts/seed-attorneys.ts --with-user-token",
  );
}

// `band` is the header copy — supplied by the page, because this component is
// shared between / and /attorneys and each holds its own copy (D9, D11). The
// cards are NOT per-page: they're attorney documents, fetched here.
//
// `background` sets the section ground: "paper" (default) or "card"
// (near-white --cog-paper-card), used on the standalone /attorneys page.
interface Props {
  band: {
    eyebrow: string | null;
    headingLead: string | null;
    headingStrong: string | null;
    lede: unknown;
  };
  background?: "paper" | "card";
}
const { band, background = "paper" } = Astro.props;

---

<section class:list={["attorneys", background === "card" && "attorneys--card"]}>
  <div class="container">
    <div class="attorneys__head">
      <div class="attorneys__head-left">
        <Eyebrow>{band.eyebrow}</Eyebrow>
        <h2 class="attorneys__heading">
          <span class="attorneys__heading-lead">{band.headingLead}</span>
          <span class="attorneys__heading-strong">{band.headingStrong}</span>
        </h2>
      </div>
      <div class="attorneys__head-right">
        <PortableText value={band.lede} components={{
          ...proseComponents,
          block: { ...proseComponents.block, normal: AttorneysLede },
        }} />
      </div>
    </div>

    {/* Only ever visible while the row actually scrolls — the script hides them
        on desktop, where all four cards fit. Same control pattern as WhyChoose. */}
    <div class="attorneys__controls" hidden>
      <button class="attorneys__arrow" data-dir="prev" type="button" aria-label="Previous attorneys">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M10.5 2.5L5 8l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="attorneys__arrow" data-dir="next" type="button" aria-label="Next attorneys">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M5.5 2.5L11 8l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="attorneys__grid">
      {
        attorneys.map((a) => (
          <a class="attorneys__card" href={`/our-team/${a.slug}`}>
            <div class="attorneys__photo">
              <img
                src={urlFor(a.photo).width(790).auto("format").url()}
                srcset={PHOTO_WIDTHS.map((w) => `${urlFor(a.photo).width(w).auto("format").url()} ${w}w`).join(", ")}
                alt={a.name}
                sizes={PHOTO_SIZES}
                loading="lazy"
                decoding="async"
                width={790}
                height={790}
                class="attorneys__photo-img lazy-fade"
              />
              <span class="attorneys__bar" aria-hidden="true" />
            </div>
            <div class="attorneys__body">
              <h3 class="attorneys__name">{a.name}</h3>
              <span class="attorneys__role">{a.role}</span>
              <p class="attorneys__cred">{a.credential}</p>
              <span class="attorneys__profile">
                <span class="attorneys__profile-label">View Profile</span>
                <svg class="attorneys__profile-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .attorneys {
    background-color: var(--cog-paper);
  }
  .attorneys--card {
    background-color: var(--cog-paper-card);
  }
  .attorneys .container {
    padding-block: var(--space-section);
  }

  /* ---- Header ---- */
  .attorneys__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-16);
    align-items: start;
    margin-bottom: var(--space-12);
  }
  .attorneys__head-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); /* standard eyebrow → heading gap */
  }
  .attorneys__heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.375rem, 4.2vw, 3.625rem); /* 38 → 58px */
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .attorneys__heading-lead,
  .attorneys__heading-strong {
    display: block;
  }
  .attorneys__heading-lead {
    font-style: italic;
    font-weight: 500;
    color: var(--cog-gold);
  }
  .attorneys__heading-strong {
    font-weight: 700;
    color: var(--cog-ink);
  }
  .attorneys__head-right :global(.attorneys__lede) {
    max-width: 660px;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--cog-ink-body);
  }

  /* ---- Carousel controls ---- */
  /* Ink on paper, unlike WhyChoose's white-on-navy pair — this band sits on
     --cog-paper. Same size and behaviour otherwise. */
  .attorneys__controls {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  /* `hidden` is a UA rule and the author `display: flex` above outranks it, so
     the attribute alone would leave the arrows on screen. */
  .attorneys__controls[hidden] {
    display: none;
  }
  .attorneys__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--cog-line-ink);
    border-radius: 50%;
    background-color: transparent;
    color: var(--cog-ink);
    cursor: pointer;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      color var(--transition);
  }
  .attorneys__arrow:hover {
    background-color: var(--cog-ink);
    border-color: var(--cog-ink);
    color: var(--cog-white);
  }

  /* ---- Card grid ---- */
  .attorneys__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .attorneys__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--cog-paper-card);
    box-shadow: 0 12px 30px rgba(14, 27, 45, 0.08);
    color: inherit;
    text-decoration: none;
  }
  .attorneys__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .attorneys__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    /* Keep the fade-in opacity transition alongside the hover-zoom. */
    transition:
      transform 0.6s var(--ease),
      opacity 0.7s var(--ease);
  }
  .attorneys__card:hover .attorneys__photo-img {
    transform: scale(1.045);
  }
  /* Accent bar wipes across the top of the card on hover. */
  .attorneys__bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--cog-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .attorneys__card:hover .attorneys__bar {
    transform: scaleX(1);
  }

  .attorneys__body {
    display: flex;
    flex: 1; /* fill the card so View Profile can pin to the bottom */
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .attorneys__name {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.5625rem); /* 22 → 25px */
    line-height: 1.05;
    color: var(--cog-ink);
  }
  .attorneys__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cog-accent);
  }
  .attorneys__cred {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--cog-ink-body);
  }
  .attorneys__profile {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    margin-top: auto; /* pin to the bottom so all cards align */
    padding-top: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cog-ink);
  }
  .attorneys__profile-label {
    border-bottom: 1px solid var(--cog-ink);
    padding-bottom: 3px;
  }
  .attorneys__profile-icon {
    color: var(--cog-accent);
    transition: transform var(--transition);
  }
  .attorneys__card:hover .attorneys__profile-icon {
    transform: translateX(4px);
  }

  /* ---- Responsive: horizontal peek carousel (no scrollbar) ---- */
  @media (max-width: 900px) {
    .attorneys__head {
      grid-template-columns: 1fr;
      row-gap: var(--space-8);
      margin-bottom: var(--space-8);
    }
    /* First card honors the container padding (left); the row bleeds to the right
       screen edge so the peek runs off-screen with no right gap mid-scroll, while
       the matching trailing padding lets the last card rest one padding in from the
       edge. Both must match .container's actual padding at this width (32px ≤1360). */
    .attorneys__grid {
      display: flex;
      gap: var(--space-6);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline-end: calc(-1 * var(--space-8));
      padding-inline-end: var(--space-8);
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* legacy Edge */
    }
    .attorneys__grid::-webkit-scrollbar {
      display: none; /* Chrome, Safari */
    }
    .attorneys__card {
      flex: 0 0 44%; /* tablet: next card peeks */
      scroll-snap-align: start;
    }
  }
  @media (max-width: 650px) {
    .attorneys__grid {
      margin-inline-end: calc(-1 * var(--space-6)); /* match container padding (24px) */
      padding-inline-end: var(--space-6);
    }
    .attorneys__card {
      flex-basis: 64%; /* mobile: smaller cards, next card peeks */
    }
    .attorneys__photo {
      aspect-ratio: 3 / 3;
    }
  }
</style>

<script>
  // Arrows for the tablet/mobile peek carousel. Mirrors WhyChoose's controls so
  // the two rows behave identically.
  //
  // The band renders on the homepage AND /our-team, so bind every instance and
  // scope each one to its own root.
  document.querySelectorAll<HTMLElement>(".attorneys").forEach((root) => {
    const scroller = root.querySelector<HTMLElement>(".attorneys__grid");
    const controls = root.querySelector<HTMLElement>(".attorneys__controls");
    if (!scroller || !controls) return;

    // Read the gap from the computed style rather than hardcoding it, so
    // changing the CSS can't silently leave the arrows scrolling by the wrong
    // amount. `columnGap` is the flex gap once the carousel media query applies.
    const step = () => {
      const card = scroller.querySelector<HTMLElement>(".attorneys__card");
      const gap = parseFloat(getComputedStyle(scroller).columnGap) || 0;
      return card ? card.offsetWidth + gap : 320;
    };

    root
      .querySelector('[data-dir="prev"]')
      ?.addEventListener("click", () =>
        scroller.scrollBy({ left: -step(), behavior: "smooth" }),
      );
    root
      .querySelector('[data-dir="next"]')
      ?.addEventListener("click", () =>
        scroller.scrollBy({ left: step(), behavior: "smooth" }),
      );

    // Above 900px the grid is a static 4-up with nothing to scroll, so the
    // arrows would be dead controls. They start hidden in the markup — showing
    // them only once the row genuinely overflows avoids a flash of arrows on
    // desktop before this runs.
    const syncControls = () => {
      controls.hidden = scroller.scrollWidth <= scroller.clientWidth + 1;
    };
    syncControls();
    window.addEventListener("resize", syncControls);
  });
</script>
