---
// "Schedule Your Consultation" band — contact form + photo. Renders on 13 pages.
//
// The copy is ONE shared Consult record used on every page (the per-page override
// was removed at the firm's request).
//
// The photo stays a prop for art direction (D6), but every page now takes the
// default: the firm asked for the one team photo across all consult sections, so
// /our-firm and /contact no longer pass their own.
//
// The form's labels, placeholders and button text stay in code — only
// the fineprint and thank-you are editable, since they're client-facing legal
// statements rather than UI chrome.
import { Image } from "astro:assets";
import { PortableText } from "astro-portabletext";
import type { ImageMetadata } from "astro";
import Eyebrow from "./Eyebrow.astro";
import { proseComponents } from "./prose/components";
import ConsultBody from "./consult/ConsultBody.astro";
import ConsultForm from "./consult/ConsultForm.astro";
import defaultPhoto from "../assets/consult-team.jpg";
import { getConsult } from "../sanity/lib/consult";

interface Props {
  photo?: ImageMetadata;
  photoAlt?: string;
}

const {
  photo = defaultPhoto,
  photoAlt = "The Cogdell Law Firm team in a courthouse corridor",
} = Astro.props;

const consult = await getConsult();

if (!consult) {
  throw new Error(
    "No Consult content found in Sanity.\n" +
      "Add it in the Studio at /admin → Consult, or seed it with:\n" +
      "  npx sanity exec scripts/seed-consult.ts --with-user-token",
  );
}
---

<section class="consult" id="contact">
  <div class="container consult__inner">
    <div class="consult__panel">
      <Eyebrow>{consult.eyebrow}</Eyebrow>
      <h2 class="consult__heading">
        <span class="consult__heading-lead">{consult.headingLead}</span>
        <span class="consult__heading-strong">{consult.headingStrong}</span>
      </h2>
      <PortableText
        value={consult.body}
        components={{
          ...proseComponents,
          block: { ...proseComponents.block, normal: ConsultBody },
        }}
      />

      <ConsultForm fineprint={consult.fineprint} thankYou={consult.thankYou} />
    </div>

    <div class="consult__media">
      <Image
        src={photo}
        alt={photoAlt}
        widths={[640, 976]}
        sizes="(max-width: 900px) 100vw, 45vw"
        class="consult__photo lazy-fade"
      />
    </div>
  </div>
</section>

<style>
  .consult {
    background-color: var(--cog-paper);
    overflow: hidden;
  }
  .consult__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-16);
    align-items: center;
    padding-block: var(--space-section);
  }

  /* ---- Copy ---- */
  .consult__heading {
    margin-top: var(--space-4); /* standard eyebrow → heading gap */
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 3.4vw, 3rem); /* 34 → 48px */
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .consult__heading-lead,
  .consult__heading-strong {
    display: block;
  }
  .consult__heading-lead {
    font-style: italic;
    font-weight: 500;
    color: var(--cog-gold);
  }
  .consult__heading-strong {
    font-weight: 700;
    color: var(--cog-ink);
  }
  .consult__panel :global(.consult__body) {
    max-width: 560px;
    margin: var(--space-4) 0 var(--space-4);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--cog-ink-body);
  }

  /* The form's own styles live in consult/ConsultForm.astro — Astro scopes by
     component, so they had to travel with the markup. */

  /* ---- Media ---- */
  .consult__media {
    align-self: stretch;
    display: flex;
  }
  .consult__photo {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    object-position: center;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .consult__inner {
      grid-template-columns: 1fr;
      row-gap: var(--space-12);
    }
    /* Photo first is nicer on stacked mobile */
    .consult__media {
      order: -1;
    }
    .consult__photo {
      min-height: 420px;
    }
  }
</style>
