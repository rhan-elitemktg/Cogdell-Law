---
// The interior-page sidebar rail: consultation form, then a navigation tree.
// Shared by practice-area pages (Practice Areas tree) and location pages
// (Areas We Serve tree) — only `navHeading`/`navItems` differ.
//
// The form is the same one the bottom Consult band renders, reading the same
// Consult singleton, so the firm edits its copy in one place. The rail skips
// `consult.body`'s longer siblings — it renders the body but nothing else the
// band shows — because the rail is ~414px wide.
//
// `id="case-evaluation"` is this form's anchor. The bottom band keeps
// `id="contact"`, which 10+ pages link to.
import { PortableText } from "astro-portabletext";
import type { NavItem } from "../../data/navigation";
import Eyebrow from "../Eyebrow.astro";
import ConsultForm from "../consult/ConsultForm.astro";
import ConsultBody from "../consult/ConsultBody.astro";
import RailNav from "./RailNav.astro";
import { proseComponents } from "../prose/components";
import { getConsult } from "../../sanity/lib/consult";

interface Props {
  pathname: string;
  navHeading: string;
  navItems: NavItem[];
}

const { pathname, navHeading, navItems } = Astro.props;

const consult = await getConsult();

if (!consult) {
  throw new Error(
    "No Consult content found in Sanity.\n" +
      "Add it in the Studio at /admin → Consult, or seed it with:\n" +
      "  npx sanity exec scripts/seed-consult.ts --with-user-token",
  );
}
---

<aside class="rail">
  <div class="rail__inner">
    <section class="rail__form" id="case-evaluation">
      <Eyebrow>{consult.eyebrow}</Eyebrow>
      {/* One tone on one line, unlike the band's stacked italic/bold pair — the
          rail is narrow and the mockup reads as a single white serif line. */}
      <h2 class="rail__heading">
        {consult.headingLead} {consult.headingStrong}
      </h2>
      <div class="rail__body">
        <PortableText
          value={consult.body}
          components={{
            ...proseComponents,
            block: { ...proseComponents.block, normal: ConsultBody },
          }}
        />
      </div>
      <ConsultForm
        variant="rail"
        idPrefix="rail-consult"
        fineprint={consult.fineprint}
        thankYou={consult.thankYou}
      />
    </section>

    <RailNav heading={navHeading} items={navItems} pathname={pathname} />
  </div>
</aside>

<style>
  .rail__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    /* Sticky needs the grid to be `align-items: start` — see .pa-body__grid. */
    position: sticky;
    top: var(--space-8);
  }

  .rail__form {
    /* Same radial recipe as the imageless PageHero, so the panel reads as part
       of the same family rather than a flat navy block. */
    background: radial-gradient(
      120% 100% at 20% 0%,
      var(--cog-navy) 0%,
      var(--cog-navy-deep) 60%
    );
    border-top: 3px solid var(--cog-accent);
    padding: var(--space-8);
  }
  .rail__heading {
    margin: var(--space-4) 0 0; /* standard eyebrow → heading gap */
    font-family: var(--font-heading);
    font-weight: 700;
    /* Keep in step with .rnav__heading — the two rail panels share a scale. */
    font-size: var(--text-2xl);
    line-height: 1.06;
    letter-spacing: -0.01em;
    color: var(--cog-white);
  }

  /* Scoped styles don't reach into a child component's markup, hence :global (F14). */
  .rail__body :global(.consult__body) {
    margin: var(--space-4) 0 var(--space-8);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--cog-navlink);
  }

  /* Readability: the band renders the fineprint as small italic serif, which on
     navy at this size is genuinely hard to read. Body font, upright, brighter. */
  .rail__form :global(.consult__fineprint) {
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--cog-navlink);
  }
  .rail__form :global(.consult__thanks) {
    color: var(--cog-white);
  }
  .rail__form :global(.consult__error) {
    color: var(--cog-cream);
  }
  .rail__form :global(.consult__error a) {
    color: var(--cog-white);
  }

  /* Below the two-column breakpoint the rail is just another stacked block, so
     drop the sticky (it has nothing left to stick against). */
  @media (max-width: 1024px) {
    .rail__inner {
      position: static;
    }
  }
</style>
