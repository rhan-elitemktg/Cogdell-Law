---
// Interior page hero — full-bleed photo with a left-to-right navy scrim,
// eyebrow + two-tone title + lede, and CTA buttons via the default slot.
//
// The photo comes from one of two places. `image` is a build-time asset import
// (astro:assets, the original path — most pages hardcode theirs). `sanityImage`
// is an editor-uploaded image, served straight off Sanity's CDN via urlFor the
// same way Attorneys/Press do, since astro:assets can't process a remote URL at
// build time. `sanityImage` wins when both are set, which is what lets a page
// ship a default asset and let an editor override it.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SanityImageSource } from "@sanity/image-url/lib/types/types";
import { urlFor } from "../sanity/lib/image";
import Eyebrow from "./Eyebrow.astro";

/** A Sanity image object; `hotspot` rides along when the editor sets one. */
type SanityHeroImage = { hotspot?: { x: number; y: number } | null } | null;

interface Props {
  eyebrow: string;
  titleLead?: string; // italic cream line — omit for a single-tone title
  titleStrong: string; // bold white line
  lede?: string;
  image?: ImageMetadata; // omit for a plain navy hero (no photo)
  sanityImage?: SanityHeroImage; // editor override — takes precedence over `image`
  imageAlt?: string;
  imagePosition?: string;
  align?: "left" | "center"; // content-column position — text stays left (default left)
  contentMaxWidth?: string; // content column width (default 720px)
}

const {
  eyebrow,
  titleLead,
  titleStrong,
  lede,
  image,
  sanityImage,
  imageAlt = "",
  imagePosition = "center 30%",
  align = "left",
  contentMaxWidth = "720px",
} = Astro.props;

// Same widths the astro:assets branch emits, so both paths serve like-for-like.
const HERO_WIDTHS = [900, 1200, 1584];
const heroUrl = (w: number) =>
  urlFor(sanityImage as SanityImageSource).width(w).auto("format").url();

const sanitySrc = sanityImage ? heroUrl(1584) : null;
const sanitySrcset = sanityImage
  ? HERO_WIDTHS.map((w) => `${heroUrl(w)} ${w}w`).join(", ")
  : null;

// The photo is object-fit:cover, so the hotspot is exactly an object-position —
// honouring it here is what makes the Studio's focal point control do anything.
const hotspot = sanityImage?.hotspot;
const resolvedPosition = hotspot
  ? `${(hotspot.x * 100).toFixed(1)}% ${(hotspot.y * 100).toFixed(1)}%`
  : imagePosition;

const hasPhoto = Boolean(sanitySrc || image);
---

<section class:list={["page-hero", !hasPhoto && "page-hero--plain"]}>
  {
    sanitySrc ? (
      <img
        src={sanitySrc}
        srcset={sanitySrcset}
        sizes="100vw"
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="page-hero__bg"
      />
    ) : image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={HERO_WIDTHS}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="page-hero__bg"
      />
    ) : null
  }
  {hasPhoto && <div class="page-hero__overlay" aria-hidden="true" />}

  <div class="container page-hero__inner">
    <div
      class:list={[
        "page-hero__content",
        align === "center" && "page-hero__content--center",
      ]}
    >
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 class="page-hero__title">
        {titleLead && <span class="page-hero__title-lead">{titleLead}</span>}
        <span class="page-hero__title-strong">{titleStrong}</span>
      </h1>
      {lede && <p class="page-hero__lede">{lede}</p>}
      <div class="page-hero__actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<style define:vars={{ imagePosition: resolvedPosition, contentMaxWidth }}>
  .page-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--cog-navy-deep);
    color: var(--cog-white);
  }
  /* Imageless variant: a subtle navy glow instead of a photo + scrim. */
  .page-hero--plain {
    background: radial-gradient(
      125% 120% at 15% 0%,
      var(--cog-navy) 0%,
      var(--cog-navy-deep) 55%
    );
  }
  /* Extra bottom room so an overlapping section (e.g. contact cards) clears the lede. */
  .page-hero--plain .page-hero__inner {
    padding-bottom: calc(var(--space-section));
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--imagePosition);
  }
  /* Darken from the left so the text column reads over the photo. */
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(7, 16, 29, 0.96) 0%,
      rgba(7, 16, 29, 0.88) 42%,
      rgba(7, 16, 29, 0.6) 78%,
      rgba(7, 16, 29, 0.4) 100%
    );
  }

  .page-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: var(--space-section);
  }
  .page-hero__content {
    /* `width` matters once __inner becomes a flex column at ≥901px: an auto
       cross-axis margin DISABLES flex stretch, so `--center`'s margin-inline
       would otherwise shrink this to its intrinsic width and centre the text.
       Filling the line first, then capping with max-width, reproduces exactly
       what block layout did — and is a no-op below the breakpoint. */
    width: 100%;
    max-width: var(--contentMaxWidth);
  }
  /* Centers the content column in the container (so it sits above a centered
     body column) — the text, eyebrow, and buttons stay left-aligned. */
  .page-hero__content--center {
    margin-inline: auto;
  }

  .page-hero__title {
    margin-top: var(--space-4); /* standard eyebrow → heading gap */
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4.4vw, 3.75rem); /* 40 → 60px */
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .page-hero__title-lead,
  .page-hero__title-strong {
    display: block;
  }
  .page-hero__title-lead {
    font-style: italic;
    font-weight: 500;
    color: var(--cog-cream);
  }
  .page-hero__title-strong {
    font-weight: 700;
    color: var(--cog-white);
  }

  .page-hero__lede {
    max-width: 560px;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--cog-white);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .page-hero__actions:empty {
    display: none;
  }

  /* ---- Responsive ---- */
  /* Interior heroes hold a floor on desktop, so a one-line title doesn't make a
     shallow band beside a two-line one — the photo needs room to read as a
     photo. Below this the hero is content-sized as before: 410px of a phone
     screen is a wall.
     `min-height` includes the padding (box-sizing is border-box globally), so
     this is the hero's total height, not an addition to it. The flex column
     centres the content in whatever extra room the floor creates; heroes already
     taller than 410px are untouched. */
  @media (min-width: 901px) {
    .page-hero__inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 410px;
    }
  }
</style>
