---
// Breadcrumb trail for nested pages. Practice Areas / … — no Home crumb; Home
// is always one click away in the header nav.
//
// CURRENTLY UNUSED — the firm pulled breadcrumbs site-wide on 2026-07-29 and the
// component was kept for when they come back. It was on practice areas, location
// pages, /news/* and /site-map; the `trail` builders that fed it all still exist
// (`trailFor` in areasWeServe.ts, the trail on getPracticeAreaNode), so putting
// it back is an import and one line per page.
//
// Note it also emitted the pages' BreadcrumbList JSON-LD, which went with it —
// nothing else on the site emits that schema.
import type { Crumb } from "../../lib/breadcrumb";
import JsonLd from "../seo/JsonLd.astro";
import { breadcrumbSchema } from "../../lib/schema";

interface Props {
  trail: Crumb[];
  /**
   * Drop the paper band, `.container` and 800px cap and emit just the crumb row,
   * so a page can place it inside its own content column at that column's width.
   */
  bare?: boolean;
}

const { trail, bare = false } = Astro.props;

// BreadcrumbList markup comes from the same trail the crumbs render, so every
// page that shows breadcrumbs gets it with no change of its own (D15).
const siteUrl = (Astro.site?.href ?? "https://www.cogdell-law.com/").replace(/\/+$/, "");
const schema = breadcrumbSchema(trail, siteUrl);
---

{schema && <JsonLd data={schema} />}

<nav class:list={["crumbs", bare && "crumbs--bare"]} aria-label="Breadcrumb">
  <div class:list={[!bare && "container", "crumbs__inner", bare && "crumbs__inner--bare"]}>
    {
      trail.map((crumb, i) => (
        <Fragment>
          {i > 0 && (
            <span class="crumbs__sep" aria-hidden="true">/</span>
          )}
          {i === trail.length - 1 ? (
            <span class="crumbs__current" aria-current="page">
              {crumb.title}
            </span>
          ) : crumb.href ? (
            <a class="crumbs__link" href={crumb.href}>
              {crumb.title}
            </a>
          ) : (
            <span class="crumbs__link">{crumb.title}</span>
          )}
        </Fragment>
      ))
    }
  </div>
</nav>

<style>
  .crumbs {
    background-color: var(--cog-paper);
  }
  /* No overflow-x here: the trail wraps, so it never scrolls sideways. An
     `overflow-x: scroll` reserves a scrollbar gutter whether or not there is
     anything to scroll, which showed as a permanently empty track for anyone on
     classic (non-overlay) scrollbars — i.e. Windows, and macOS set to "Show
     scroll bars: Always". */
  .crumbs__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2);
    /* Safety valve the scroller used to provide: an unbroken token longer than
       the column breaks instead of pushing the row wide. */
    overflow-wrap: anywhere;
    padding-block: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    max-width: 800px;
  }
  .crumbs__link {
    color: var(--cog-ink-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .crumbs__link:hover {
    color: var(--cog-accent);
  }
  .crumbs__sep {
    color: var(--cog-line-ink);
  }
  .crumbs__current {
    color: var(--cog-ink);
    font-weight: 600;
  }

  /* Bare: no band, no container, no width cap — the host column owns all three. */
  .crumbs--bare {
    background-color: transparent;
    border-bottom: 0;
  }
  .crumbs__inner--bare {
    max-width: none;
    padding-inline: 0;
    padding-block: 0 var(--space-6);
  }
</style>
