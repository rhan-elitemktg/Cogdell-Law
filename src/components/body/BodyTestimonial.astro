---
// The `bodyTestimonial` block of a `pageBody` field (D16) — a client review as a
// paper card in the flow of the page.
//
// The odd one out in this family: the other four are navy interruptions, this one
// sits on the page's own paper and borrows the blockquote's card treatment,
// because a review is evidence rather than a call to action.
//
// `node.testimonial` arrives already dereferenced — both body queries give
// `bodyTestimonial` its own `_type ==` arm in the `body[]{…}` projection.
import { relativeTime } from "../../lib/relativeTime";

interface BodyTestimonialNode {
  _type: "bodyTestimonial";
  _key: string;
  testimonial?: {
    quote?: string;
    author?: string;
    reviewedAt?: string | null;
  } | null;
}

interface Props {
  node: BodyTestimonialNode;
  index?: number;
  isInline?: boolean;
}

const { node } = Astro.props;
const review = node.testimonial;

// Five stars, hardcoded — the site has no rating field, and every other
// testimonial rendering (Testimonials.astro, the wall) shows five too.
const STARS = 5;

// Empty when the testimonial has no date, so the whole line drops out.
const when = relativeTime(review?.reviewedAt);
---

<aside class="bodytest">
  <span class="bodytest__mark" aria-hidden="true">&#x275D;</span>

  <figure class="bodytest__figure">
    <figcaption class="bodytest__head">
      <p class="bodytest__author">{review?.author}</p>
      <div class="bodytest__meta">
        <div class="bodytest__stars" role="img" aria-label={`${STARS} out of ${STARS} stars`}>
          {
            Array.from({ length: STARS }).map(() => (
              <svg class="bodytest__star" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M11.48 3.5a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.563.563 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345z" />
              </svg>
            ))
          }
        </div>
        {/* The visible text is built at deploy time and can drift; the datetime
            attribute carries the real date so the markup stays correct. */}
        {when && review?.reviewedAt && (
          <time class="bodytest__when" datetime={review.reviewedAt}>{when}</time>
        )}
      </div>
    </figcaption>

    <blockquote class="bodytest__quote">
      <p class="bodytest__text">{review?.quote}</p>
    </blockquote>
  </figure>
</aside>

<style>
  /* Paper card on paper, with the blockquote's lift — same --shadow-card token,
     so "match the blockquote" can't quietly stop being true. No accent border
     though: the blockquote's left rule marks quoted body copy, and this card is
     already set apart by being a card. See F14 — this markup is emitted by this
     component, so plain scoped rules match it. */
  .bodytest {
    position: relative;
    display: block;
    margin-block: var(--space-12);
    padding: var(--space-10) var(--space-8);
    background-color: var(--cog-paper-card);
    box-shadow: var(--shadow-card);
  }
  .bodytest:first-child {
    margin-top: 0;
  }
  .bodytest:last-child {
    margin-bottom: 0;
  }

  /* Sits in the corner as a watermark, so it's out of the text's way and quiet
     enough not to compete with the accent stars. */
  .bodytest__mark {
    position: absolute;
    top: var(--space-6);
    right: var(--space-8);
    font-family: var(--font-ornament);
    font-size: 3rem; /* 48px */
    line-height: 1;
    color: var(--cog-line);
  }

  .bodytest__figure {
    margin: 0;
  }

  .bodytest__author {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.2vw, 1.875rem); /* 24 → 30px, as .bodyatty__name */
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--cog-ink);
  }

  .bodytest__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .bodytest__stars {
    display: flex;
    gap: var(--space-1);
    color: var(--cog-accent);
  }
  .bodytest__when {
    font-size: var(--text-sm);
    color: var(--cog-ink-muted);
  }

  .bodytest__quote {
    margin: var(--space-6) 0 0;
  }
  /* --text-base, not the --text-md the navy blocks use: this one is on paper and
     reads as part of the page, so it matches the site's other testimonials. */
  .bodytest__text {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--cog-ink-body);
  }

  /* ---- Responsive ---- */
  @media (max-width: 650px) {
    .bodytest {
      padding: var(--space-8) var(--space-6);
    }
    /* The watermark would collide with a wrapped name in a narrow card. */
    .bodytest__mark {
      display: none;
    }
  }
</style>
