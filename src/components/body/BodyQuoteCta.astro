---
// The `bodyQuoteCta` block of a `pageBody` field (D16) — navy band, accent quote
// mark, the passage in the attorney's own voice, attribution, buttons, and their
// photo on the right.
//
// Rendered through pageBodyComponents' `type` map, so it receives Portable Text
// node props ({ node, index, isInline }) and never page props — which is why the
// phone is fetched here rather than passed in.
//
// `node.attorney` arrives already dereferenced: both body queries give
// `bodyQuoteCta` its own `_type ==` arm in the `body[]{…}` projection.
import { getFirmDetails } from "../../sanity/lib/firmDetails";
import { urlFor } from "../../sanity/lib/image";

interface CtaButton {
  label?: string | null;
  href?: string | null;
}

interface BodyQuoteCtaNode {
  _type: "bodyQuoteCta";
  _key: string;
  quote?: string;
  primaryCta?: CtaButton;
  secondaryCta?: CtaButton;
  attorney?: {
    name?: string;
    photo?: Parameters<typeof urlFor>[0];
    photoAlt?: string;
  } | null;
}

interface Props {
  node: BodyQuoteCtaNode;
  index?: number;
  isInline?: boolean;
}

const { node } = Astro.props;
const attorney = node.attorney;

const firm = await getFirmDetails();
const phone = firm?.phone ?? "713-426-2244";
const phoneHref = `tel:+1${phone.replace(/[^0-9]/g, "")}`; // matches Header/Footer

// Tests both fields, not the object: an editor who types a label and then clears
// it leaves a `{_type: "ctaButton"}` husk behind, which is truthy but unusable.
const resolve = (button: CtaButton | undefined, fallback: Required<CtaButton>) =>
  button?.label && button?.href
    ? { label: button.label, href: button.href }
    : fallback;

const primary = resolve(node.primaryCta, {
  label: "Schedule Consultation",
  href: "/contact",
});
const secondary = resolve(node.secondaryCta, {
  label: `Call Us ${phone}`,
  href: phoneHref,
});

// Portrait crop rather than bodyAttorney's square — the taller frame is what
// balances a block of quoted copy, and it tops out level with the quote mark.
// Photos live in Sanity (D6), so they come off its CDN via urlFor; the wide end
// of the srcset is for the stacked layout, where the photo runs the full column.
const PHOTO = 200;
const RATIO = 10 / 9; // height ÷ width
const PHOTO_WIDTHS = [200, 400, 650, 900];
const PHOTO_SIZES = "(max-width: 650px) 100vw, 200px";
const crop = (w: number) =>
  urlFor(attorney!.photo!)
    .width(w)
    .height(Math.round(w * RATIO))
    .fit("crop")
    .url();
const photoUrl = attorney?.photo ? crop(PHOTO * 2) : null;
const photoSrcset = attorney?.photo
  ? PHOTO_WIDTHS.map((w) => `${crop(w)} ${w}w`).join(", ")
  : undefined;
---

<aside class:list={["bodyquote", { "bodyquote--nophoto": !photoUrl }]}>
  {/* Photo first in the DOM and first in the grid, so the stacked mobile layout
      leads with it for free — no `order` needed. Same arrangement as
      bodyAttorney. */}
  {
    photoUrl && (
      <img
        class="bodyquote__photo"
        src={photoUrl}
        srcset={photoSrcset}
        sizes={PHOTO_SIZES}
        alt={attorney?.photoAlt ?? attorney?.name ?? ""}
        width={PHOTO}
        height={Math.round(PHOTO * RATIO)}
        loading="lazy"
        decoding="async"
      />
    )
  }

  <div class="bodyquote__main">
    {/* U+275D HEAVY DOUBLE TURNED COMMA QUOTATION MARK ORNAMENT — deliberately
        NOT “ (U+201C). Cormorant draws that one as a thin hairline comma; the
        ornament is the heavy round mark the design uses. */}
    <span class="bodyquote__mark" aria-hidden="true">&#x275D;</span>

    <figure class="bodyquote__figure">
      <blockquote class="bodyquote__quote">
        <p class="bodyquote__text">{node.quote}</p>
      </blockquote>
      {
        attorney?.name && (
          <figcaption class="bodyquote__attrib">{attorney.name}</figcaption>
        )
      }
    </figure>

    <div class="bodyquote__actions">
      <a href={primary.href} class="btn btn--primary">
        {primary.label}
        <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a href={secondary.href} class="btn btn--outline">
        {secondary.label}
        <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</aside>

<style>
  /* Same ground, rule, padding and margins as the other body blocks — the family
     reads as one in a column. See F14: this markup is emitted by this component,
     so plain scoped rules match it. */
  .bodyquote {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: var(--space-8);
    align-items: start;
    margin-block: var(--space-12);
    padding: var(--space-10) var(--space-8);
    background-color: var(--cog-navy-deep);
    border-top: 3px solid var(--cog-accent);
    color: var(--cog-white);
  }
  /* An attorney with no photo yet shouldn't leave a 200px hole. */
  .bodyquote--nophoto {
    grid-template-columns: minmax(0, 1fr);
  }
  .bodyquote:first-child {
    margin-top: 0;
  }
  .bodyquote:last-child {
    margin-bottom: 0;
  }

  .bodyquote__photo {
    display: block;
    width: 200px;
    height: auto;
    aspect-ratio: 9 / 10;
    object-fit: cover;
  }
  .bodyquote__main {
    min-width: 0;
  }

  /* Matched to the design's own rule: Cormorant at 56px, line-height 0.6, accent.
     No font-weight — the heft comes from the ❝ ornament itself, and forcing 700
     would only get a synthesised bold. The 0.6 pulls the glyph's leading out so
     it sits tight above the quote, same as QuoteBand. Flat rather than a clamp
     because it's a fixed ornament, like .prose__quote::before. */
  .bodyquote__mark {
    display: block;
    font-family: var(--font-ornament);
    font-size: 3.5rem; /* 56px */
    line-height: 0.6;
    color: var(--cog-accent);
  }

  .bodyquote__figure {
    margin: 0;
  }
  .bodyquote__quote {
    margin: var(--space-3) 0 0;
  }
  /* Same size as .bodyatty__copy — the two blocks sit in one column and reading
     at different sizes made them look unrelated. */
  .bodyquote__text {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--cog-white);
  }

  /* Cream rather than QuoteBand's --cog-navlink: the mockup warms the
     attribution to sit with the accent rule above it. */
  .bodyquote__attrib {
    margin-top: var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cog-cream);
  }

  .bodyquote__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* ---- Responsive ---- */
  /* Stacks photo-over-quote, left aligned — same call as bodyAttorney: this
     block carries a paragraph, and centred body copy is harder to read.
     Buttons go full-width (global .btn rule at 650px). */
  @media (max-width: 650px) {
    .bodyquote {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-8);
      padding: var(--space-6);
    }
    .bodyquote__photo {
      width: 100%;
    }
    .bodyquote__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
