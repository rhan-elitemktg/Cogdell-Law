---
// Collapsible, timestamped transcript. Native <details> so it works without JS
// and is keyboard-accessible; open by default (matches the mockup).
interface Cue {
  _key?: string;
  time: string | null;
  text: string | null;
}

interface Props {
  cues: Cue[];
}

const { cues } = Astro.props;
---

<details class="ptrans" open>
  <summary class="ptrans__head">
    <span class="ptrans__title">Transcript</span>
    <svg class="ptrans__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </summary>
  <div class="ptrans__body">
    {
      cues.map((cue) => (
        <div class="ptrans__cue">
          <span class="ptrans__time">{cue.time}</span>
          <p class="ptrans__text">{cue.text}</p>
        </div>
      ))
    }
  </div>
</details>

<style>
  .ptrans {
    border: 1px solid var(--cog-line-ink);
    background-color: var(--cog-paper-card);
  }
  .ptrans__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cog-ink);
  }
  /* Hide the native disclosure triangle (Safari + others). */
  .ptrans__head::-webkit-details-marker {
    display: none;
  }
  .ptrans__chev {
    flex-shrink: 0;
    color: var(--cog-ink-muted);
    transition: transform var(--transition);
  }
  .ptrans[open] .ptrans__chev {
    transform: rotate(180deg);
  }

  .ptrans__body {
    padding: var(--space-2) var(--space-6) var(--space-6);
    border-top: 1px solid var(--cog-line-ink);
  }
  .ptrans__cue {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .ptrans__cue + .ptrans__cue {
    border-top: 1px solid var(--cog-line-ink);
  }
  .ptrans__time {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--cog-accent);
    padding-top: 2px;
  }
  .ptrans__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--cog-ink-body);
  }

  @media (max-width: 650px) {
    .ptrans__cue {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
