---
// "Related Podcasts" — a 3-up grid of episode cards at the foot of an episode
// page. Reuses PodcastCard and the same grid spacing as the index (no filter).
import PodcastCard from "./PodcastCard.astro";

interface Props {
  items: Array<{
    _id: string;
    title: string | null;
    episodeNumber: number | null;
    tag: string | null;
    slug: string | null;
    date: string | null;
    coverImage: unknown;
  }>;
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="prelated">
      <div class="container prelated__inner">
        <h2 class="prelated__heading">Related Podcasts</h2>
        <div class="prelated__grid">
          {items.map((item) => (
            <PodcastCard item={item} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .prelated {
    background-color: var(--cog-paper);
  }
  .prelated__inner {
    padding-block: var(--space-section);
  }
  .prelated__heading {
    margin: 0 0 var(--space-12);
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-3xl);
    line-height: 1.1;
    color: var(--cog-ink);
  }
  .prelated__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .prelated__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 650px) {
    .prelated__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
