---
// One episode card: the video thumbnail + date + title + "Watch Now".
// The whole card links to the episode page; the button is a visual affordance
// (a span, not a nested link) so there's a single accessible target.
//
// `data-search` is the pre-normalised haystack PodcastGrid's search reads —
// built here, server-side, so the matcher never touches the DOM for text.
import PodcastArtwork from "./PodcastArtwork.astro";

interface Props {
  item: {
    title: string | null;
    youtubeId: string | null;
    slug: string | null;
    date: string | null;
    coverImage: unknown;
  };
  loading?: "eager" | "lazy";
  /** SSR'd initial state — PodcastGrid hides cards beyond the first page. */
  hidden?: boolean;
}

const { item, loading = "lazy", hidden = false } = Astro.props;

const date = item.date ? new Date(item.date) : null;
const dateLabel = date
  ? date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : "";
const title = item.title ?? "";

// Title plus the written date and year, so "deguerin", "rusty hardin", "march"
// and "2026" all find something. Normalised the same way the query will be:
// lowercased, accents folded, punctuation collapsed to single spaces.
const haystack = `${title} ${dateLabel}`
  .toLowerCase()
  .normalize("NFKD")
  .replace(/[̀-ͯ]/g, "")
  .replace(/[^a-z0-9]+/g, " ")
  .trim();
---

<a class="pcard" href={`/podcast/${item.slug}`} data-search={haystack} hidden={hidden}>
  <PodcastArtwork image={item.coverImage} youtubeId={item.youtubeId} loading={loading} />
  <div class="pcard__body">
    <p class="pcard__meta">
      {dateLabel && <span class="pcard__date">{dateLabel}</span>}
    </p>
    <h3 class="pcard__title">{title}</h3>
    <span class="pcard__watch">
      {/* A play triangle, not the old microphone — these are videos now. */}
      <svg class="pcard__play" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
      </svg>
      Watch Now
    </span>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background-color: var(--cog-paper-card);
    border: 1px solid var(--cog-line-ink);
    text-decoration: none;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(14, 27, 45, 0.1);
  }
  .pcard[hidden] {
    display: none;
  }

  .pcard__body {
    display: flex;
    flex: 1; /* fill the card so the CTA can pin to the bottom */
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
  }
  .pcard__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .pcard__date {
    color: var(--cog-ink-muted);
  }
  .pcard__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    line-height: 1.2;
    color: var(--cog-ink);
    transition: color var(--transition);
  }
  .pcard:hover .pcard__title {
    color: var(--cog-accent-dark);
  }

  /* Compact card CTA — deliberately not the site-wide .btn (that's the large
     arrow button); the podcast cards use a compact play-led "Watch Now". */
  .pcard__watch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    /* Pin to the bottom so the chips line up across a row of uneven titles —
       the same trick Attorneys.astro uses for its "View Profile" link. */
    margin-top: auto;
    padding: 10px var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cog-white);
    background-color: var(--cog-accent);
    transition: background-color var(--transition);
  }
  .pcard:hover .pcard__watch {
    background-color: var(--cog-accent-dark);
  }
  .pcard__play {
    flex-shrink: 0;
  }
</style>
