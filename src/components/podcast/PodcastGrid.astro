---
// Searchable, paginated episode grid.
//
// The tag filter row this replaced made sense for a handful of curated episodes;
// with 80+ it did not, and half the catalogue didn't fit the taxonomy anyway.
// A search box scales instead, and every card is already in the HTML — the grid
// server-renders all of them and hides the overflow — so searching costs no
// extra fetch and no extra markup beyond one `data-search` attribute per card.
//
// "Load More" is unchanged: typing resets the page exactly as changing filter did.
import PodcastCard from "./PodcastCard.astro";

interface Props {
  items: Array<{
    _id: string;
    title: string | null;
    slug: string | null;
    date: string | null;
    coverImage: unknown;
  }>;
}

const { items } = Astro.props;

// First page size — the rest are revealed by "Load More".
const BATCH = 9;
---

<section class="pgrid" data-batch={BATCH}>
  <div class="container pgrid__inner">
    {/* Hidden server-side and revealed by the script below. Stronger than a
        `html.js` class: if the script FAILS rather than merely being disabled,
        the field stays hidden instead of sitting there dead. */}
    <div class="pgrid__search" hidden>
      <label class="pgrid__search-label" for="podcast-search">Search episodes</label>
      <input
        class="pgrid__search-input"
        id="podcast-search"
        type="search"
        autocomplete="off"
        placeholder="Search by title, guest or year…"
      />
      <p class="pgrid__count" role="status" aria-live="polite"></p>
    </div>

    <div class="pgrid__grid">
      {items.map((item, i) => <PodcastCard item={item} hidden={i >= BATCH} loading={i < 3 ? "eager" : "lazy"} />)}
    </div>

    <p class="pgrid__empty" hidden>No episodes match that search.</p>

    <button class="pgrid__more" type="button" hidden={items.length <= BATCH}>
      Load More Episodes
      <svg class="pgrid__more-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
  </div>
</section>

<noscript>
  <style>
    /* No JS: reveal every episode (search and paging are enhancements). */
    .pgrid .pcard[hidden] { display: flex !important; }
    .pgrid__more { display: none !important; }
  </style>
</noscript>

<style>
  .pgrid {
    background-color: var(--cog-paper);
  }
  .pgrid__inner {
    padding-block: var(--space-section);
  }

  /* ---- Search ---- */
  .pgrid__search {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--cog-line-ink);
  }
  .pgrid__search[hidden] {
    display: none;
  }
  .pgrid__search-label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cog-ink-muted);
  }
  .pgrid__search-input {
    width: 100%;
    height: 56px;
    padding: 14px 16px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--cog-ink);
    background-color: var(--cog-white);
    border: 1px solid var(--cog-line-ink);
    border-radius: 0;
    transition: border-color var(--transition);
  }
  .pgrid__search-input::placeholder {
    color: var(--cog-ink-muted);
  }
  .pgrid__search-input:focus {
    outline: none;
    border-color: var(--cog-accent);
  }
  .pgrid__count {
    margin-top: var(--space-3);
    min-height: 1.2em; /* reserve the line so results don't jump the grid */
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cog-ink-muted);
  }

  /* ---- Grid (matches TrialResults spacing) ---- */
  .pgrid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  .pgrid__empty {
    margin-top: var(--space-12);
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--cog-ink-muted);
  }
  .pgrid__empty[hidden] {
    display: none;
  }

  /* ---- Load more ---- */
  .pgrid__more {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-12) auto 0;
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cog-accent);
    background-color: transparent;
    border: 1px solid var(--cog-accent);
    cursor: pointer;
    transition:
      color var(--transition),
      background-color var(--transition);
  }
  .pgrid__more:hover {
    color: var(--cog-white);
    background-color: var(--cog-accent);
  }
  .pgrid__more[hidden] {
    display: none;
  }
  .pgrid__more-icon {
    flex-shrink: 0;
    transition: transform var(--transition);
  }
  .pgrid__more:hover .pgrid__more-icon {
    transform: translateX(4px);
  }

  /* ---- Responsive (matches TrialResults) ---- */
  @media (max-width: 900px) {
    .pgrid__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 650px) {
    .pgrid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Fuzzy search over the episode cards.
  //
  // Hand-rolled rather than a library: this runs over ~82 pre-normalised strings
  // that are already in the DOM, which is sub-millisecond work, and a search
  // dependency would be the largest script on a site that otherwise ships almost
  // none. No debounce for the same reason — there is nothing to defer.
  document.querySelectorAll<HTMLElement>(".pgrid").forEach((root) => {
    const searchWrap = root.querySelector<HTMLElement>(".pgrid__search");
    const input = root.querySelector<HTMLInputElement>(".pgrid__search-input");
    const count = root.querySelector<HTMLElement>(".pgrid__count");
    const empty = root.querySelector<HTMLElement>(".pgrid__empty");
    const grid = root.querySelector<HTMLElement>(".pgrid__grid");
    const loadMore = root.querySelector<HTMLButtonElement>(".pgrid__more");
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".pcard"));
    const BATCH = Number(root.dataset.batch) || 9;

    if (!grid) return;
    // The script is alive, so the field is usable.
    if (searchWrap) searchWrap.hidden = false;

    let limit = BATCH;
    let tokens: string[] = [];

    /**
     * Within one edit of each other, transpositions included — so "durts" still
     * finds "durst", which a plain Levenshtein check would score as two edits.
     */
    function withinOneEdit(a: string, b: string): boolean {
      if (a === b) return true;
      if (Math.abs(a.length - b.length) > 1) return false;
      if (a.length === b.length) {
        const diff: number[] = [];
        for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) diff.push(i);
        if (diff.length === 1) return true;
        return (
          diff.length === 2 &&
          diff[1] === diff[0] + 1 &&
          a[diff[0]] === b[diff[1]] &&
          a[diff[1]] === b[diff[0]]
        );
      }
      const [short, long] = a.length < b.length ? [a, b] : [b, a];
      for (let i = 0; i < long.length; i++) {
        if (short === long.slice(0, i) + long.slice(i + 1)) return true;
      }
      return false;
    }

    /**
     * Match a token against WHOLE WORDS, never across the haystack.
     *
     * An earlier version accepted a subsequence anywhere in the string — chars
     * in order with unlimited gaps. That works for filename pickers, where the
     * haystack is short and dense; over a sentence it matches almost anything.
     * Measured against these 82 episodes, "rhan" hit 70 of them and "waco" hit
     * 57 without appearing in a single title.
     *
     * Higher is better; 0 rejects. One unmatched token rejects the whole card,
     * so adding a word narrows rather than widens.
     */
    function tokenScore(words: string[], t: string): number {
      const numeric = /^\d+$/.test(t);
      let best = 0;
      for (const w of words) {
        if (w === t) best = Math.max(best, 100);
        else if (w.startsWith(t)) best = Math.max(best, 80);
        else if (t.length >= 3 && w.includes(t)) best = Math.max(best, 50);
        // Typo tolerance is for words, not numbers: without this guard a search
        // for "2026" also returns every 2025 episode, one substitution away.
        else if (t.length >= 4 && !numeric && withinOneEdit(w, t)) best = Math.max(best, 20);
      }
      return best;
    }

    function scoreOf(card: HTMLElement): number {
      if (!tokens.length) return 1; // no query — everything matches equally
      const words = (card.dataset.search ?? "").split(" ");
      let total = 0;
      for (const t of tokens) {
        const s = tokenScore(words, t);
        if (!s) return 0;
        total += s;
      }
      return total;
    }

    const normalise = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[^a-z0-9]+/g, " ")
        .trim();

    // Render the visible set. `animateFrom` = the visible position at/after which
    // to run the entrance animation (0 = animate all, e.g. on a new search;
    // old-limit = only the freshly revealed batch; null = no animation, initial).
    function render(animateFrom: number | null) {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const scored = cards.map((card, i) => ({ card, i, score: scoreOf(card) }));
      const hits = scored.filter((s) => s.score > 0);

      // Relevance order while searching, newest-first otherwise. Ordering matters
      // because only the first `limit` are shown — the best match has to land in
      // the first batch. Real DOM moves, since `style.order` would be an inline
      // style and the house rules forbid those.
      if (tokens.length) {
        hits.sort((a, b) => b.score - a.score || a.i - b.i);
        for (const h of hits) grid!.append(h.card);
      } else if (scored.some((s, i) => s.i !== i)) {
        for (const s of scored) grid!.append(s.card);
      }

      const visible = new Set(hits.slice(0, limit).map((h) => h.card));
      let pos = 0;
      for (const { card } of scored) {
        const show = visible.has(card);
        card.hidden = !show;
        if (show && !reduce && animateFrom != null && pos >= animateFrom) {
          card.animate(
            [
              { opacity: 0, transform: "translateY(14px)" },
              { opacity: 1, transform: "translateY(0)" },
            ],
            {
              duration: 400,
              delay: (pos - animateFrom) * 45,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              fill: "backwards",
            },
          );
        }
        if (show) pos++;
      }

      if (loadMore) loadMore.hidden = limit >= hits.length;
      if (empty) empty.hidden = hits.length > 0;
      if (count) {
        count.textContent = !tokens.length
          ? ""
          : `${hits.length} ${hits.length === 1 ? "episode" : "episodes"}`;
      }
    }

    input?.addEventListener("input", () => {
      tokens = normalise(input.value).split(" ").filter(Boolean);
      limit = BATCH;
      render(0);
    });

    loadMore?.addEventListener("click", () => {
      const from = limit;
      limit += BATCH;
      render(from);
    });

    // Initial pass — reconcile with the SSR'd hidden state, no animation.
    render(null);
  });
</script>
