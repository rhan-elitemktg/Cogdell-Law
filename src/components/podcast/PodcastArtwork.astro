---
// An episode's 16:9 artwork — the video's own YouTube thumbnail. Used by the
// index and related-episode cards.
//
// It used to be a code-rendered brand lockup over a stock photo, which meant all
// 82 cards looked identical and the grid was impossible to scan. Real thumbnails
// are the whole point now, so there is no scrim and no lockup over them.
//
// Source order: the editor's coverImage if they've uploaded one, then the
// YouTube thumbnail, then the firm default. That last branch is close to
// unreachable — youtubeId is required — but renders something rather than a hole
// if an id is ever malformed.
import { urlFor } from "../../sanity/lib/image";
import { getImage } from "astro:assets";
import defaultCover from "../../assets/white-collar-defense.jpg";
import type { SanityImageSource } from "@sanity/image-url";
import { youtubeThumbnail } from "../../lib/youtube";

interface Props {
  image?: SanityImageSource | null;
  youtubeId?: string | null;
  loading?: "eager" | "lazy";
  class?: string;
}

const { image, youtubeId, loading = "lazy", class: className } = Astro.props;

const thumb = youtubeThumbnail(youtubeId);
const src = image
  ? urlFor(image).width(880).height(495).fit("crop").auto("format").url()
  : (thumb?.src ?? (await getImage({ src: defaultCover, width: 880, height: 495 })).src);
---

<div class:list={["pcast-art", className]}>
  <img
    class="pcast-art__bg lazy-fade"
    src={src}
    alt=""
    loading={loading}
    decoding="async"
    width="880"
    height="495"
    data-fallback={thumb?.fallback}
  />
</div>

<style>
  .pcast-art {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--cog-navy-deep);
    /* The orange top rule that sits above every episode card. */
    border-top: 3px solid var(--cog-accent);
  }
  .pcast-art__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* `cover` matters for the fallback rung: hqdefault is 4:3 with letterbox
       bars baked in, and cropping to 16:9 removes exactly those bars. */
    object-fit: cover;
  }
</style>

<script>
  // Two of the channel's videos were never uploaded above 720p, so they have no
  // maxresdefault thumbnail and YouTube will not backfill one. Swap those to the
  // rung that always exists rather than shipping a broken image.
  //
  // A listener rather than an inline onerror attribute: same progressive
  // enhancement the rest of the site uses, and it catches the cards the grid
  // reveals later too.
  //
  // Scoped to this component's own images. A bare `img[data-fallback]` would
  // also pick up YouTubeArtwork's, which works only for as long as an episode
  // page happens to render related cards — a coupling that would break silently
  // the day one doesn't.
  document.querySelectorAll<HTMLImageElement>(".pcast-art__bg[data-fallback]").forEach((img) => {
    img.addEventListener(
      "error",
      () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) img.src = fallback;
      },
      { once: true },
    );
  });
</script>
