---
// The Cogdell Law Uncensored episode artwork — a code-rendered brand lockup over
// the episode's background photo. Used by the index and related-episode CARDS, so
// every episode looks on-brand from one uploaded photo (no pre-made image files).
//
// The episode page does NOT use this: there the artwork carries the title and a
// play button and becomes the video — see YouTubeArtwork.astro. Putting the title
// on the card artwork too would render it twice, since the card already prints it
// underneath.
//
// Text scales with the artwork's own width (container-query units), so the lockup
// reads correctly at any card size.
import { urlFor } from "../../sanity/lib/image";
import { getImage } from "astro:assets";
import defaultCover from "../../assets/white-collar-defense.jpg";
import type { SanityImageSource } from "@sanity/image-url";

interface Props {
  image?: SanityImageSource | null;
  loading?: "eager" | "lazy";
  class?: string;
}

const { image, loading = "lazy", class: className } = Astro.props;

// The editor's uploaded photo when present; otherwise the firm-wide default.
const src = image
  ? urlFor(image).width(880).height(495).fit("crop").auto("format").url()
  : (await getImage({ src: defaultCover, width: 880, height: 495 })).src;
---

<div class:list={["pcast-art", className]}>
  <img
    class="pcast-art__bg lazy-fade"
    src={src}
    alt=""
    loading={loading}
    decoding="async"
    width="880"
    height="495"
  />
  <div class="pcast-art__scrim" aria-hidden="true"></div>
  <div class="pcast-art__lockup">
    <span class="pcast-art__the">The</span>
    <span class="pcast-art__name">Cogdell Law</span>
    <span class="pcast-art__kicker">Uncensored</span>
    <span class="pcast-art__rule" aria-hidden="true"></span>
  </div>
</div>

<style>
  .pcast-art {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--cog-navy-deep);
    /* The orange top rule that sits above every episode card. */
    border-top: 3px solid var(--cog-accent);
  }
  .pcast-art__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcast-art__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 50% 40%, rgba(7, 16, 29, 0.72) 0%, rgba(7, 16, 29, 0.92) 100%),
      linear-gradient(180deg, rgba(7, 16, 29, 0.55) 0%, rgba(7, 16, 29, 0.85) 100%);
  }
  .pcast-art__lockup {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6cqw;
    color: var(--cog-white);
  }
  .pcast-art__the {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2.8cqw;
    line-height: 1;
    color: var(--cog-cream);
  }
  .pcast-art__name {
    margin-top: 0.4cqw;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 6.6cqw;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--cog-white);
  }
  .pcast-art__kicker {
    margin-top: 1.6cqw;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 2.3cqw;
    /* Eased from 0.42em, which was set for the 7-character "PODCAST".
       "UNCENSORED" is 10 and overruns the lockup at the old tracking. */
    letter-spacing: 0.34em;
    /* letter-spacing pushes the block right; nudge it back to stay centered. */
    text-indent: 0.34em;
    text-transform: uppercase;
    color: var(--cog-navlink);
  }
  .pcast-art__rule {
    width: 5cqw;
    height: 2px;
    margin-top: 2cqw;
    background-color: var(--cog-accent);
  }
</style>
