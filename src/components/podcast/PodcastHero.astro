---
// Podcast index hero — bespoke, centered, full-bleed photo with an even dark
// wash (PageHero only does a left-directional scrim with left-aligned text).
// Centered eyebrow + serif title + subtitle, over a studio photo.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Eyebrow from "../Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}

const { eyebrow, title, subtitle, image, imageAlt = "", imagePosition = "center 35%" } = Astro.props;
---

<section class="phero">
  <Image
    src={image}
    alt={imageAlt}
    widths={[900, 1200, 1584]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="phero__bg"
  />
  <div class="phero__scrim" aria-hidden="true"></div>

  <div class="container phero__inner">
    <div class="phero__content">
      <Eyebrow tone="accent" center rule={false}>{eyebrow}</Eyebrow>
      <h1 class="phero__title">{title}</h1>
      {subtitle && <p class="phero__subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style define:vars={{ imagePosition }}>
  .phero {
    position: relative;
    overflow: hidden;
    background-color: var(--cog-navy-deep);
    color: var(--cog-white);
  }
  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--imagePosition);
  }
  /* Even, symmetric dark wash so the centered text reads anywhere over the photo. */
  .phero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(7, 16, 29, 0.78) 0%,
      rgba(7, 16, 29, 0.72) 45%,
      rgba(7, 16, 29, 0.86) 100%
    );
  }

  .phero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(72px, 11vw, 150px);
  }
  .phero__content {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .phero__title {
    margin-top: var(--space-4); /* standard eyebrow → heading gap */
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2.5rem, 5vw, 4rem); /* 40 → 64px */
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--cog-white);
  }
  .phero__subtitle {
    max-width: 620px;
    margin: var(--space-6) auto 0;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--cog-navlink);
  }
</style>
